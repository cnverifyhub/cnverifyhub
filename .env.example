# CNVerifyHub — Environment Variables
# Copy this file to .env.local and fill in real values

# ──────────────────────────────────────────
# SUPABASE
# ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ──────────────────────────────────────────
# CRYPTO WALLETS
# ──────────────────────────────────────────
# USDT - TRC20 (Main, Recommended)
NEXT_PUBLIC_TRC20_WALLET=TPdyaSUty1yFnjU2kGM7Uc9yBY7yz9KRvY
NEXT_PUBLIC_TRC20_WALLET_2=TPUxa1UGWLo7iHpx8fWK63YwxqP4FPzHnj

# USDT / BTC - BNB Smart Chain BEP20
NEXT_PUBLIC_BEP20_WALLET=0x95EEa6cA1CCCB2f281E9d9F9BBbD19315B971fe3

# BTC - Ethereum ERC20
NEXT_PUBLIC_ERC20_WALLET=0x95EEa6cA1CCCB2f281E9d9F9BBbD19315B971fe3

# Solana
NEXT_PUBLIC_SOLANA_WALLET=2bPuP5T4NXp3u7p52RT7BgJdJpwRquvmf2mCh329sHHM

# ──────────────────────────────────────────
# CONTACT
# ──────────────────────────────────────────
NEXT_PUBLIC_TELEGRAM_CHANNEL=t.me/CNVerifyHub
NEXT_PUBLIC_TELEGRAM_USER=t.me/CNVerifyHub
NEXT_PUBLIC_CONTACT_EMAIL=cnverifyhub@gmail.com

# ──────────────────────────────────────────
# BLOCKCHAIN VERIFICATION (free API keys)
# ──────────────────────────────────────────
# Get from: https://bscscan.com/myapikey
BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# Get from: https://tonapi.io
TONAPI_API_KEY=YOUR_TONAPI_API_KEY

# ──────────────────────────────────────────
# ADMIN ACCESS & SECURITY
# ──────────────────────────────────────────
GATE_SECRET=your_gate_secret_here
ADMIN_PASSWORD=admin888
NEXT_PUBLIC_ADMIN_PASSWORD=admin888
WEBHOOK_SECRET=your_payment_webhook_secret_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
CRON_SECRET=your_cron_secret_here

# ──────────────────────────────────────────
# ANALYTICS
# ──────────────────────────────────────────
NEXT_PUBLIC_BAIDU_ANALYTICS_ID=YOUR_BAIDU_ID
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

